    {
      "name": "Adapt Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const event = item.json.event || item.json;\n  if (event.bot_id || event.subtype === 'bot_message') continue;\n  results.push({json: {\n    question: String(event.text || '').replace(/<@[^>]+>/g, '').trim(),\n    channel: 'slack', replyTo: event.channel || '', userId: event.user || '',\n    sessionId: event.thread_ts || event.ts || ''\n  }});\n}\nreturn results;"
      },
      "position": [
        -860,
        0
      ],
      "id": "e933dc53-10b1-4c49-91e7-46a41b8a0541"
    },
    {
      "name": "Adapt Other",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(item => ({json: {\n  question: item.json.question, channel: item.json.channel || 'external',\n  replyTo: item.json.replyTo || '', userId: item.json.userId || '',\n  sessionId: item.json.sessionId || ''\n}}));"
      },
