    {
      "name": "Adapt Chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(item => ({json: {\n  question: item.json.chatInput, channel: 'n8n_chat', replyTo: '',\n  userId: '', sessionId: item.json.sessionId || ''\n}}));"
      },
