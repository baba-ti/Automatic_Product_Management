    {
      "name": "Validate Tables",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let result = $input.first().json.output;\nif (typeof result === 'string') result = JSON.parse(result);\nconst allowed = new Set($('Build Table Catalog').first().json.tables.map(t => t.table_name));\nif (!Array.isArray(result?.tables) || !result.tables.length)\n  throw new Error('No relevant tables selected.');\nconst tables = [...new Set(result.tables)];\nif (tables.some(t => typeof t !== 'string' || !allowed.has(t)))\n  throw new Error('The model selected a table outside the catalog.');\nreturn [{json: {tables}}];"
      },
      "position": [
        460,
        0
      ],
      "id": "009d7f04-f9a0-4514-8cd3-a9af9fbb3e15"
