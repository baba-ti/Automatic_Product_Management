        "inputSchema": "{\"type\": \"object\", \"properties\": {\"tables\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"minItems\": 1}}, \"required\": [\"tables\"], \"additionalProperties\": false}"
      },
