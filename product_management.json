        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => Object.keys(r).length > 0);\nreturn [{json: {rows, rowCount: rows.length, rowLimit: 100,\n  limitReached: rows.length === 100, query: $('Validate SQL').first().json.query}}];"
