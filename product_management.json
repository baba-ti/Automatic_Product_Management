    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT table_name, column_name, data_type, udt_name, is_nullable,\n       column_default, character_maximum_length, numeric_precision, numeric_scale\nFROM information_schema.columns\nWHERE table_schema = 'public'\n  AND table_name IN (SELECT jsonb_array_elements_text($1::jsonb))\nORDER BY table_name, ordinal_position;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.tables)] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
