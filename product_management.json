    {
      "name": "Request Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('Send exactly one request per execution.');\nconst request = items[0].json;\nif (typeof request.question !== 'string' || !request.question.trim())\n  throw new Error('question must be a non-empty string.');\nif (request.channel === 'slack' && !request.replyTo)\n  throw new Error('Slack requests require replyTo (channel ID).');\nreturn [{json: {...request, question: request.question.trim()}}];"
      },
      "position": [
        -620,
        0
      ],
      "id": "658cd8fd-eec8-45ed-8ef9-9275d247b515"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    col.table_name,\n    COALESCE(obj_description(c.oid), 'No description available') AS table_description,\n    string_agg(col.column_name, ', ' ORDER BY col.ordinal_position) AS all_columns\nFROM information_schema.columns col\nLEFT JOIN pg_class c ON c.relname = col.table_name\nLEFT JOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE col.table_schema = 'public'\nAND n.nspname = 'public'\nGROUP BY col.table_name, c.oid\nORDER BY col.table_name;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -380,
        0
      ],
      "id": "85638285-9ee1-4b07-b047-9a2ce91d1165",
      "name": "List Tables"
    },
    {
      "name": "Build Table Catalog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tables = $input.all().map(i => i.json).filter(t => t.table_name);\nif (!tables.length) throw new Error('No accessible tables in the public schema.');\nreturn [{json: {tables, schema: tables.map(t =>\n  `tableName: ${t.table_name}\\ntableDescription: ${t.table_description}\\ncolumnList: ${t.all_columns}`\n).join('\\n\\n')}}];"
      },
      "position": [
