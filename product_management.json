    {
      "name": "Validate SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let result = $input.first().json.output;\nif (typeof result === 'string') result = JSON.parse(result);\nconst query = String(result?.query || '').trim().replace(/;\\s*$/, '');\n// Conservative preflight only; the DB credential MUST enforce read-only privileges.\nif (!/^(select|with)\\b/i.test(query) || /;|--|\\/\\*|\\*\\//.test(query))\n  throw new Error('Only a single SELECT query without comments is allowed.');\nif (/\\b(insert|update|delete|drop|alter|create|truncate|grant|revoke|copy|call|execute|do|set|reset|into|lock|merge)\\b/i.test(query))\n  throw new Error('The SQL preflight rejected a restricted keyword.');\nif (/\\b(pg_|dblink|lo_import|lo_export)/i.test(query))\n  throw new Error('Administrative function calls are not allowed.');\nreturn [{json: {query, boundedQuery: `SELECT * FROM (${query}) AS answer_rows LIMIT 100`}}];"
      },
      "position": [
        1540,
        0
      ],
